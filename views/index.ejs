<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Data Cards</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
  <div class="container mx-auto p-6">
    <h1 class="text-5xl font-semibold text-center mb-6">Website Inquires</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      <% data.forEach(item => { %>
        <div class="bg-white rounded-2xl shadow-lg p-5 hover:shadow-2xl transition duration-300">
          <h2 class="text-xl font-semibold text-gray-800 mb-2"><%= item.email %></h2>
          <p class="text-gray-600"><%= item.contactData %> <br><br></p>
          <p class="text-gray-600 text-sm"><%= item._id %></p>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
